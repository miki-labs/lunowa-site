{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "ref": {
    "color": {
      "$type": "color",
      "page": { "$value": { "colorSpace": "srgb", "components": [0.972549, 0.972549, 0.960784], "hex": "#F8F8F5" } },
      "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
      "subtle": { "$value": { "colorSpace": "srgb", "components": [0.945098, 0.94902, 0.933333], "hex": "#F1F2EE" } },
      "ink": { "$value": { "colorSpace": "srgb", "components": [0.094118, 0.094118, 0.090196], "hex": "#181817" } },
      "inkHover": { "$value": { "colorSpace": "srgb", "components": [0.164706, 0.164706, 0.156863], "hex": "#2A2A28" } },
      "secondary": { "$value": { "colorSpace": "srgb", "components": [0.407843, 0.407843, 0.392157], "hex": "#686864" } },
      "tertiary": { "$value": { "colorSpace": "srgb", "components": [0.466667, 0.466667, 0.447059], "hex": "#777772" } },
      "border": { "$value": { "colorSpace": "srgb", "components": [0.847059, 0.847059, 0.823529], "hex": "#D8D8D2" } },
      "borderStrong": { "$value": { "colorSpace": "srgb", "components": [0.721569, 0.721569, 0.690196], "hex": "#B8B8B0" } },
      "blue": { "$value": { "colorSpace": "srgb", "components": [0.207843, 0.372549, 0.568627], "hex": "#355F91" } },
      "blueDark": { "$value": { "colorSpace": "srgb", "components": [0.168627, 0.309804, 0.486275], "hex": "#2B4F7C" } },
      "monitorBg": { "$value": { "colorSpace": "srgb", "components": [0.929412, 0.964706, 0.945098], "hex": "#EDF6F1" } },
      "monitorFg": { "$value": { "colorSpace": "srgb", "components": [0.239216, 0.427451, 0.345098], "hex": "#3D6D58" } },
      "monitorBorder": { "$value": { "colorSpace": "srgb", "components": [0.784314, 0.870588, 0.827451], "hex": "#C8DED3" } },
      "attentionBg": { "$value": { "colorSpace": "srgb", "components": [1, 0.960784, 0.909804], "hex": "#FFF5E8" } },
      "attentionFg": { "$value": { "colorSpace": "srgb", "components": [0.541176, 0.341176, 0.109804], "hex": "#8A571C" } },
      "attentionBorder": { "$value": { "colorSpace": "srgb", "components": [0.909804, 0.819608, 0.694118], "hex": "#E8D1B1" } },
      "integrityBg": { "$value": { "colorSpace": "srgb", "components": [1, 0.941176, 0.941176], "hex": "#FFF0F0" } },
      "integrityFg": { "$value": { "colorSpace": "srgb", "components": [0.607843, 0.247059, 0.247059], "hex": "#9B3F3F" } },
      "integrityBorder": { "$value": { "colorSpace": "srgb", "components": [0.905882, 0.768627, 0.768627], "hex": "#E7C4C4" } }
    },
    "space": {
      "$type": "dimension",
      "1": { "$value": { "value": 4, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "10": { "$value": { "value": 40, "unit": "px" } },
      "12": { "$value": { "value": 48, "unit": "px" } },
      "16": { "$value": { "value": 64, "unit": "px" } },
      "20": { "$value": { "value": 80, "unit": "px" } },
      "24": { "$value": { "value": 96, "unit": "px" } },
      "32": { "$value": { "value": 128, "unit": "px" } }
    },
    "radius": {
      "$type": "dimension",
      "control": { "$value": { "value": 10, "unit": "px" } },
      "surface": { "$value": { "value": 16, "unit": "px" } },
      "product": { "$value": { "value": 20, "unit": "px" } }
    }
  },
  "color": {
    "$type": "color",
    "surface": {
      "page": { "$value": "{ref.color.page}" },
      "subtle": { "$value": "{ref.color.subtle}" },
      "product": { "$value": "{ref.color.white}" }
    },
    "text": {
      "primary": { "$value": "{ref.color.ink}" },
      "secondary": { "$value": "{ref.color.secondary}" },
      "tertiary": { "$value": "{ref.color.tertiary}" }
    },
    "border": {
      "subtle": { "$value": "{ref.color.border}" },
      "strong": { "$value": "{ref.color.borderStrong}" }
    },
    "action": {
      "primary": { "$value": "{ref.color.ink}" },
      "primaryHover": { "$value": "{ref.color.inkHover}" },
      "link": { "$value": "{ref.color.blue}" },
      "linkHover": { "$value": "{ref.color.blueDark}" }
    },
    "focus": {
      "ring": { "$value": "{ref.color.blue}" }
    },
    "state": {
      "monitoring": {
        "background": { "$value": "{ref.color.monitorBg}" },
        "foreground": { "$value": "{ref.color.monitorFg}" },
        "border": { "$value": "{ref.color.monitorBorder}" }
      },
      "attention": {
        "background": { "$value": "{ref.color.attentionBg}" },
        "foreground": { "$value": "{ref.color.attentionFg}" },
        "border": { "$value": "{ref.color.attentionBorder}" }
      },
      "integrity": {
        "background": { "$value": "{ref.color.integrityBg}" },
        "foreground": { "$value": "{ref.color.integrityFg}" },
        "border": { "$value": "{ref.color.integrityBorder}" }
      }
    }
  },
  "type": {
    "family": {
      "$type": "fontFamily",
      "primary": { "$value": ["Inter Variable", "Noto Sans JP", "Hiragino Sans", "Yu Gothic UI", "Yu Gothic", "system-ui", "sans-serif"] }
    },
    "size": {
      "$type": "dimension",
      "heroWide": { "$value": { "value": 60, "unit": "px" } },
      "heroCompact": { "$value": { "value": 52, "unit": "px" } },
      "heroMobile": { "$value": { "value": 40, "unit": "px" } },
      "heroNarrow": { "$value": { "value": 36, "unit": "px" } },
      "section": { "$value": { "value": 44, "unit": "px" } },
      "sectionMobile": { "$value": { "value": 32, "unit": "px" } },
      "subsection": { "$value": { "value": 28, "unit": "px" } },
      "lead": { "$value": { "value": 20, "unit": "px" } },
      "body": { "$value": { "value": 16, "unit": "px" } },
      "ui": { "$value": { "value": 14, "unit": "px" } },
      "meta": { "$value": { "value": 12, "unit": "px" } }
    },
    "lineHeight": {
      "$type": "dimension",
      "heroWide": { "$value": { "value": 68, "unit": "px" } },
      "heroCompact": { "$value": { "value": 60, "unit": "px" } },
      "heroMobile": { "$value": { "value": 48, "unit": "px" } },
      "heroNarrow": { "$value": { "value": 44, "unit": "px" } },
      "section": { "$value": { "value": 54, "unit": "px" } },
      "sectionMobile": { "$value": { "value": 40, "unit": "px" } },
      "subsection": { "$value": { "value": 36, "unit": "px" } },
      "lead": { "$value": { "value": 32, "unit": "px" } },
      "body": { "$value": { "value": 28, "unit": "px" } },
      "ui": { "$value": { "value": 21, "unit": "px" } },
      "meta": { "$value": { "value": 18, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "layout": {
    "$type": "dimension",
    "pageGutterWide": { "$value": { "value": 48, "unit": "px" } },
    "pageGutterTablet": { "$value": { "value": 32, "unit": "px" } },
    "pageGutterMobile": { "$value": { "value": 20, "unit": "px" } },
    "contentMax": { "$value": { "value": 1120, "unit": "px" } },
    "readableMax": { "$value": { "value": 720, "unit": "px" } },
    "productMax": { "$value": { "value": 1248, "unit": "px" } },
    "sectionGapWide": { "$value": { "value": 128, "unit": "px" } },
    "sectionGapMobile": { "$value": { "value": 88, "unit": "px" } },
    "breakpointMobile": { "$value": { "value": 768, "unit": "px" } },
    "breakpointDesktop": { "$value": { "value": 1024, "unit": "px" } },
    "breakpointWide": { "$value": { "value": 1280, "unit": "px" } },
    "reflowMinimum": { "$value": { "value": 320, "unit": "px" } }
  },
  "border": {
    "$type": "dimension",
    "subtle": { "$value": { "value": 1, "unit": "px" } },
    "strong": { "$value": { "value": 1.5, "unit": "px" } }
  },
  "focus": {
    "$type": "dimension",
    "ringWidth": { "$value": { "value": 2, "unit": "px" } },
    "ringOffset": { "$value": { "value": 3, "unit": "px" } }
  },
  "interaction": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": { "value": 120, "unit": "ms" } },
      "state": { "$value": { "value": 180, "unit": "ms" } }
    }
  }
}
