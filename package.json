{
  "name": "lunowa-m15-preview",
  "version": "0.0.0-preview",
  "private": true,
  "description": "Static, non-production browser preview for Lunowa M15",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "verify:tokens": "node scripts/verify-token-map.mjs",
    "typecheck": "pnpm run verify:tokens && astro check",
    "lint": "eslint . --max-warnings=0",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build",
    "evidence": "pnpm run build && playwright test"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "astro": "7.2.9",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
